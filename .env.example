# ===========================================
# Restaurant Queue Manager - Environment Config
# Copy this to .env and fill in real values
# NEVER commit .env with real secrets!
# ===========================================

# Flask
SECRET_KEY=change-me-to-a-random-64-char-hex-string
FLASK_ENV=production

# JWT
JWT_SECRET_KEY=change-me-to-another-random-64-char-hex-string
JWT_COOKIE_SECURE=true

# Database
POSTGRES_DB=restaurant
POSTGRES_USER=restaurant
POSTGRES_PASSWORD=change-me-strong-db-password
DATABASE_URL=******postgres:5432/restaurant

# Redis
REDIS_URL=redis://redis:6379/0

# Argon2id settings
ARGON2_TIME_COST=3
ARGON2_MEMORY_COST=65536
ARGON2_PARALLELISM=1

# Frontend
FRONTEND_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:5000/api

# Sentry (optional - leave empty to disable)
SENTRY_DSN=

# Celery
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0
