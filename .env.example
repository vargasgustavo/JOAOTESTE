# Copie para .env e substitua os valores. NUNCA commite o .env real.
# Gere segredos fortes com: python -c "import secrets; print(secrets.token_urlsafe(48))"

ENV=development
DEBUG=false
LOG_LEVEL=INFO

# Segredos (obrigatorios em producao; a app se recusa a subir com "change-me")
SECRET_KEY=change-me
JWT_SECRET_KEY=change-me

# Banco e cache (o docker-compose sobrescreve com os hosts internos)
POSTGRES_USER=mesas
POSTGRES_PASSWORD=mesas
POSTGRES_DB=mesas
DATABASE_URL=postgresql+psycopg://mesas:mesas@postgres:5432/mesas
REDIS_URL=redis://redis:6379/0

# Sessao
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=1209600
# Em producao (HTTPS) mantenha COOKIE_SECURE=true.
COOKIE_SECURE=false
COOKIE_SAMESITE=Lax

# CORS: apenas a origem do frontend
CORS_ORIGINS=http://localhost:8080,http://localhost:3000

# Rate limiting
RATELIMIT_ENABLED=true
RATELIMIT_DEFAULT=200 per minute
RATELIMIT_AUTH=10 per minute
RATELIMIT_QUEUE_JOIN=5 per minute

# Estimativa de espera
DEFAULT_WAIT_MINUTES=15
TURNOVER_SAMPLE_HOURS=24
TURNOVER_SAMPLE_SIZE=50

# Notificacoes (mock no V0; troque o provider sem alterar o resto do codigo)
NOTIFICATION_PROVIDER=mock

# Observabilidade (deixe vazio para desligar; NUNCA commite um DSN real)
SENTRY_DSN=

# Infra local
HTTP_PORT=8080
RUN_SEED=true
